{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime factory-droid --event SessionStart",
          "timeout": 15
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime factory-droid --event UserPromptSubmit",
          "timeout": 15
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime factory-droid --event PreToolUse",
          "timeout": 15
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime factory-droid --event PostToolUse",
          "timeout": 15
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime factory-droid --event PreCompact",
          "timeout": 15
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime factory-droid --event Stop",
          "timeout": 15
        }
      ]
    }
  ]
}
