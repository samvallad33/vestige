{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime openhands --event SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime openhands --event UserPromptSubmit",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime openhands --event PreToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime openhands --event PostToolUse",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '~/.vestige/memory/hooks/vestige-bridge.cjs' --runtime openhands --event Stop",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
