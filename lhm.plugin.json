{
  "identifier": "samvallad33-vestige",
  "name": "Vestige",
  "version": "4.2.0",
  "author": "samvallad33",
  "authorUrl": "https://github.com/samvallad33",
  "category": "developer",
  "homepage": "https://github.com/samvallad33/vestige",
  "icon": "🧠",
  "description": "Vestige 4.2.0: the Causal Proof Engine and operating system for AI agents. Its kernel is Strata, an append-only signed log on your machine: zero vectors, zero RAG, and every answer carries its proof. Recall by exact handle, every write admitted through a gate with a receipt, GhostLink proposals of never-composed pairs with a proof from recorded edges, intentions, code records whose anchors check themselves against source, causal walks over recorded edges, and vestige prove, which bisects a failure to the commit that caused it with your own test and receipts every run. 16 MCP tools; purge is withheld until real erasure ships. Upgrading from v3 imports your records, links, intentions and code anchors on first launch and keeps the v3 file. Install the v4.2.0 binary from the GitHub Release, Homebrew (samvallad33/tap/vestige) or npm (npx -y vestige-mcp-server). Binaries: macOS Apple Silicon/Intel, Linux x64/ARM64, Windows x64. Data stays on your machine.",
  "tags": [
    "memory",
    "agent-memory",
    "long-term-memory",
    "persistent-memory",
    "ai-memory",
    "llm-memory",
    "causal-proof-engine",
    "strata",
    "operating-system",
    "local-first",
    "stdio",
    "rust",
    "mcp",
    "audit-log",
    "root-cause-analysis"
  ],
  "tools": [
    {
      "name": "causal_walk",
      "description": "Walk a failure backward from explicit start points (failing_test, stack_frame, ci_run, logged_write, version_range); any kind carries node_id, the memory recording the symptom. A Strata log follows recorded causal edges only and says why when none lead upstream. Results are hypotheses, not proven causes. promote=true records trail edges on the legacy engine only.",
      "inputSchema": {
        "properties": {
          "lookback_days": {
            "maximum": 365,
            "minimum": 1,
            "type": "integer"
          },
          "promote": {
            "type": "boolean"
          },
          "scan_limit": {
            "maximum": 5000,
            "minimum": 10,
            "type": "integer"
          },
          "scope": {
            "type": "string"
          },
          "start_points": {
            "items": {
              "properties": {
                "broke_in": {
                  "type": "string"
                },
                "frame": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "failing_test",
                    "stack_frame",
                    "ci_run",
                    "logged_write",
                    "version_range"
                  ],
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "node_id": {
                  "type": "string"
                },
                "repo": {
                  "type": "string"
                },
                "run_id": {
                  "type": "string"
                },
                "worked_in": {
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      }
    },
