{
  "manifest_version": "0.2",
  "name": "vestige",
  "display_name": "Vestige",
  "version": "2.6.0",
  "description": "Local-first MCP memory. After compaction the agent cites a signed receipt or it stops. Retroactive Salience Backfill, FSRS-6 decay, fail-closed recall. Single Rust binary.",
  "author": {
    "name": "Sam Valladares",
    "url": "https://github.com/samvallad33"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/samvallad33/vestige"
  },
  "license": "AGPL-3.0-only",
  "server": {
    "type": "binary",
    "entry_point": "server/vestige-mcp-darwin-arm64",
    "mcp_config": {
      "command": "${__dirname}/server/vestige-mcp-darwin-arm64",
      "args": [],
      "env": {},
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/server/vestige-mcp-win32-x64.exe"
        },
        "linux": {
          "command": "${__dirname}/server/vestige-mcp-linux-x64"
        }
      }
    }
  }
}
