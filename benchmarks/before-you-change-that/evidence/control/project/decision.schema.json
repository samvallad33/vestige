{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic reconciliation decision",
  "type": "object",
  "required": ["schema_version", "cause", "evidence_ids", "causal_path", "rejected_hypotheses", "changed_files"],
  "properties": {
    "schema_version": {"const": 1},
    "cause": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "causal_path": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "required": ["from", "to", "relation"],
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "relation": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "rejected_hypotheses": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["hypothesis", "evidence_ids", "reason"],
        "properties": {
          "hypothesis": {"type": "string"},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "changed_files": {"type": "array", "minItems": 1, "uniqueItems": true,
                      "items": {"enum": ["src/ledger/reconcile.rs", "runtime.conf"]}}
  },
  "additionalProperties": false
}
